diff --git a/lib/services/archive_creation_outcome.dart b/lib/services/archive_creation_outcome.dart
new file mode 100644
index 0000000000000000000000000000000000000000..1b1f8fe625ce92b282873c226f23aa6a54622426
--- /dev/null
+++ b/lib/services/archive_creation_outcome.dart
@@ -0,0 +1,82 @@
+/// Completed archive outputs, optional source cleanup, and a stopped batch.
+/// A partial failure never authorizes rollback or automatic cleanup retries.
+class ArchiveCreationOutcome {
+  ArchiveCreationOutcome({
+    required List<String> archivePaths,
+    List<ArchiveSourceCleanupFailure> sourceCleanupFailures = const [],
+    this.batchFailure,
+  }) : archivePaths = List.unmodifiable(archivePaths),
+       sourceCleanupFailures = List.unmodifiable(sourceCleanupFailures);
+
+  final List<String> archivePaths;
+  final List<ArchiveSourceCleanupFailure> sourceCleanupFailures;
+  final ArchiveBatchFailure? batchFailure;
+
+  bool get archiveCreated => archivePaths.isNotEmpty;
+  bool get isPartial => batchFailure != null || sourceCleanupFailures.isNotEmpty;
+
+  String get message {
+    final failure = batchFailure;
+    if (failure != null) {
+      final cleanupMessage = sourceCleanupFailures.isEmpty
+          ? ''
+          : ' ${sourceCleanupFailures.length} source(s) could not be removed.';
+      return '${archivePaths.length} archive output(s) created; batch stopped at '
+          '"${failure.sourcePath}": ${failure.error}. '
+          'Existing archives were kept; cleanup for the failed and remaining batch items was skipped.'
+          '$cleanupMessage';
+    }
+    return sourceCleanupFailures.isNotEmpty
+        ? 'Archive created, but ${sourceCleanupFailures.length} source(s) could not be removed. '
+              'The archive was kept; review the remaining sources before retrying cleanup.'
+        : 'Archive created successfully';
+  }
+
+  Map<String, Object> toWorkerMessage() => {
+    'status': isPartial ? 'partial' : 'completed',
+    'archiveCreated': archiveCreated,
+    'reason': batchFailure != null
+        ? 'batchCreationFailed'
+        : isPartial
+        ? 'sourceCleanupFailed'
+        : 'archiveCreated',
+    'archivePaths': archivePaths,
+    'sourceCleanupFailures': sourceCleanupFailures
+        .map((failure) => failure.toMap())
+        .toList(),
+    'message': message,
+    if (batchFailure != null) 'batchFailure': batchFailure!.toMap(),
+  };
+}
+
+/// The first creation error that stopped a batch after earlier outputs succeeded.
+/// Keep the original error and stack for direct callers; serialize text for ports.
+class ArchiveBatchFailure {
+  const ArchiveBatchFailure({
+    required this.sourcePath,
+    required this.archivePath,
+    required this.error,
+    required this.stackTrace,
+  });
+
+  final String sourcePath;
+  final String archivePath;
+  final Object error;
+  final StackTrace stackTrace;
+
+  Map<String, String> toMap() => {
+    'sourcePath': sourcePath,
+    'archivePath': archivePath,
+    'error': error.toString(),
+    'stackTrace': stackTrace.toString(),
+  };
+}
+
+class ArchiveSourceCleanupFailure {
+  const ArchiveSourceCleanupFailure(this.path, this.error);
+
+  final String path;
+  final String error;
+
+  Map<String, String> toMap() => {'path': path, 'error': error};
+}
diff --git a/lib/services/archive_extraction.dart b/lib/services/archive_extraction.dart
new file mode 100644
index 0000000000000000000000000000000000000000..8acd353f7437fdd753a9994ab855d5bfe537c647
--- /dev/null
+++ b/lib/services/archive_extraction.dart
@@ -0,0 +1,261 @@
+import 'dart:async';
+import 'dart:io';
+import 'dart:typed_data';
+
+import 'package:archive/archive_io.dart';
+import 'package:dart_lz4/dart_lz4.dart';
+import 'package:just_zstd/just_zstd.dart';
+import 'package:path/path.dart' as p;
+
+import 'archive_extraction_staging.dart';
+import 'archive_format_support.dart';
+import 'archive_no_overwrite_safety.dart';
+
+class ArchiveExtractionFailure implements Exception {
+  ArchiveExtractionFailure(
+    this.cause,
+    this.publishedPaths, {
+    this.cancelled = false,
+  });
+  final Object cause;
+  final List<String> publishedPaths;
+  final bool cancelled;
+  bool get isPartial => publishedPaths.isNotEmpty;
+  @override
+  String toString() =>
+      '${isPartial ? "Partial extraction: published outputs preserved; " : "Extraction failed: "}$cause';
+}
+
+/// Decode completely into anonymous operation-private files before publishing.
+/// Publication is exclusive per file, NOT atomic across files or crash-safe.
+class ArchiveExtraction {
+  static Future<void> extract({
+    required String archivePath,
+    required String destinationDir,
+    String? password,
+    bool background = false,
+    bool Function()? isCancelled,
+    Future<void> Function(String phase, List<String> publishedPaths)?
+    onBoundary,
+  }) async {
+    // Keep the public unsupported-format exception contract unchanged.
+    ArchiveFormatSupport.requireExtractable(
+      archivePath,
+      background: background,
+    );
+    final staged = <String, ArchivePrivateFile>{};
+    final published = <String>[];
+    final resources = <ArchivePrivateFile>[];
+    final streams = <InputFileStream>[];
+    ArchiveExclusivePublisher? publisher;
+    Future<void> boundary(String phase) async {
+      await onBoundary?.call(phase, List.unmodifiable(published));
+      await Future<void>.delayed(Duration.zero);
+      if (isCancelled?.call() ?? false) {
+        throw ArchiveExtractionFailure(
+          'Cancellation requested',
+          List.unmodifiable(published),
+          cancelled: true,
+        );
+      }
+    }
+
+    void created(String relative) {
+      final path = p.join(destinationDir, relative);
+      if (!published.contains(path)) published.add(path);
+    }
+
+    try {
+      final originalName = archivePath.toLowerCase();
+      String inputPath = archivePath;
+      if (archivePath.endsWith('.001')) {
+        final combined = ArchivePrivateFile();
+        resources.add(combined);
+        final output = File(combined.path).openSync(mode: FileMode.write);
+        try {
+          final base = archivePath.substring(0, archivePath.length - 4);
+          for (var part = 1; ; part++) {
+            final file = File('$base.${part.toString().padLeft(3, '0')}');
+            if (!file.existsSync()) break;
+            final input = file.openSync();
+            try {
+              while (true) {
+                final bytes = input.readSync(65536);
+                if (bytes.isEmpty) break;
+                output.writeFromSync(bytes);
+              }
+            } finally {
+              input.closeSync();
+            }
+          }
+        } finally {
+          output.closeSync();
+        }
+        inputPath = combined.path;
+      }
+
+      InputFileStream openInput(String path) {
+        final stream = InputFileStream(path);
+        streams.add(stream);
+        return stream;
+      }
+
+      late Archive archive;
+      if (originalName.endsWith('.zip') || originalName.contains('.zip.')) {
+        archive = ZipDecoder().decodeBuffer(
+          openInput(inputPath),
+          password: password?.isNotEmpty == true ? password : null,
+        );
+      } else if (originalName.endsWith('.tar.gz') ||
+          originalName.endsWith('.tgz')) {
+        final tar = ArchivePrivateFile();
+        resources.add(tar);
+        final output = OutputFileStream(tar.path);
+        try {
+          GZipDecoder().decodeStream(openInput(inputPath), output);
+        } finally {
+          output.closeSync();
+        }
+        archive = TarDecoder().decodeBuffer(openInput(tar.path));
+      } else if (originalName.endsWith('.tar')) {
+        archive = TarDecoder().decodeBuffer(openInput(inputPath));
+      } else {
+        final bytes = File(inputPath).readAsBytesSync();
+        if (originalName.endsWith('.tar.bz2') ||
+            originalName.endsWith('.tbz2')) {
+          archive = TarDecoder().decodeBytes(BZip2Decoder().decodeBytes(bytes));
+        } else if (originalName.endsWith('.tar.lz4') ||
+            originalName.endsWith('.tlz4')) {
+          archive = TarDecoder().decodeBytes(
+            Uint8List.fromList(lz4FrameDecode(bytes)),
+          );
+        } else if (originalName.endsWith('.tar.zst') ||
+            originalName.endsWith('.tzst')) {
+          archive = TarDecoder().decodeBytes(
+            Uint8List.fromList(const ZstdDecoder().decodeBytes(bytes)),
+          );
+        } else if (originalName.endsWith('.gz') ||
+            originalName.endsWith('.bz2') ||
+            originalName.endsWith('.lz4') ||
+            originalName.endsWith('.zst') ||
+            originalName.endsWith('.zstd')) {
+          final decoded = originalName.endsWith('.gz')
+              ? GZipDecoder().decodeBytes(bytes)
+              : originalName.endsWith('.bz2')
+              ? BZip2Decoder().decodeBytes(bytes)
+              : originalName.endsWith('.lz4')
+              ? lz4FrameDecode(bytes)
+              : const ZstdDecoder().decodeBytes(bytes);
+          archive = Archive()
+            ..addFile(
+              ArchiveFile(
+                p.basenameWithoutExtension(archivePath),
+                decoded.length,
+                decoded,
+              ),
+            );
+        } else {
+          archive = ZipDecoder().decodeBuffer(
+            openInput(inputPath),
+            password: password?.isNotEmpty == true ? password : null,
+          );
+        }
+      }
+
+      final targets = <String, bool>{};
+      for (final entry in archive.files) {
+        final name = _relativeName(entry.name);
+        if (name.isEmpty && entry.isFile) {
+          throw FileSystemException('Empty archive file name');
+        }
+        if (targets[name] == true ||
+            (entry.isFile && targets.containsKey(name))) {
+          throw FileSystemException(
+            'Duplicate or colliding archive output',
+            entry.name,
+          );
+        }
+        targets[name] = entry.isFile;
+      }
+      for (final name in targets.keys) {
+        var parent = p.posix.dirname(name);
+        while (parent != '.' && parent.isNotEmpty) {
+          if (targets[parent] == true) {
+            throw FileSystemException('Archive file/directory collision', name);
+          }
+          parent = p.posix.dirname(parent);
+        }
+      }
+      for (final entry in archive.files) {
+        await boundary('staging');
+        final name = _relativeName(entry.name);
+        if (!entry.isFile) continue;
+        final output = ArchivePrivateFile();
+        resources.add(output);
+        staged[name] = output;
+        final writer = OutputFileStream(output.path);
+        try {
+          entry.writeContent(writer);
+        } finally {
+          writer.closeSync();
+        }
+      }
+      // Destination validation belongs to publication, after decode/staging.
+      await boundary('staged');
+      publisher = ArchiveExclusivePublisher(
+        destinationDir,
+        onRootCreated: (path) {
+          if (!published.contains(path)) published.add(path);
+        },
+      );
+      validateArchiveExtractionPlan(destinationDir, archive.files);
+      for (final entry in archive.files) {
+        await boundary('publishing');
+        final name = _relativeName(entry.name);
+        if (entry.isFile) {
+          publisher.publishFile(name, staged[name]!, created);
+        } else if (name.isNotEmpty) {
+          publisher.publishDirectory(name, created);
+        }
+        await boundary('published');
+      }
+    } on ArchiveExtractionFailure {
+      rethrow;
+    } catch (error) {
+      throw ArchiveExtractionFailure(error, List.unmodifiable(published));
+    } finally {
+      publisher?.close();
+      for (final stream in streams.reversed) {
+        try {
+          stream.closeSync();
+        } catch (_) {}
+      }
+      // Closing owned anonymous descriptors lets the kernel reclaim exactly
+      // those inodes. No destination/staging pathname is ever unlinked.
+      for (final resource in resources.reversed) {
+        resource.close();
+      }
+    }
+  }
+
+  static String _relativeName(String name) {
+    final portable = name.replaceAll('\\', '/');
+    if (portable.isEmpty ||
+        portable.contains('\u0000') ||
+        portable.startsWith('/') ||
+        RegExp(r'^[A-Za-z]:').hasMatch(portable)) {
+      throw FileSystemException('Unsafe archive entry path', name);
+    }
+    final parts = portable
+        .split('/')
+        .where((part) => part.isNotEmpty && part != '.')
+        .toList();
+    if (parts.contains('..')) {
+      throw FileSystemException(
+        'Archive entry contains parent traversal',
+        name,
+      );
+    }
+    return parts.join('/');
+  }
+}
diff --git a/lib/services/archive_extraction_staging.dart b/lib/services/archive_extraction_staging.dart
new file mode 100644
index 0000000000000000000000000000000000000000..9c32703941555f2aa5b2cd0a416c91cbce8329ac
--- /dev/null
+++ b/lib/services/archive_extraction_staging.dart
@@ -0,0 +1,306 @@
+import 'dart:convert';
+import 'dart:ffi';
+import 'dart:io';
+
+import 'package:path/path.dart' as p;
+
+/// Linux/Android retained-descriptor staging and exclusive publication.
+/// There is deliberately no pathname-based rollback or unsafe fallback.
+class ArchivePrivateFile implements Finalizable {
+  ArchivePrivateFile() {
+    final api = _NativeFiles.instance;
+    final fd = api.withString(
+      Directory.systemTemp.path,
+      (path) => api.open(path, 0x410000 | 2 | 0x80000, 384),
+    ); // O_TMPFILE|RDWR
+    if (fd < 0) api.fail('Anonymous private extraction staging unavailable');
+    _stream = api.withString('w+b', (mode) => api.fdopen(fd, mode));
+    if (_stream == nullptr) {
+      api.close(fd);
+      api.fail('Cannot retain private extraction staging');
+    }
+    descriptor = fd;
+    _finalizer.attach(this, _stream, detach: _detach);
+  }
+
+  static final _finalizer = NativeFinalizer(
+    _NativeFiles.instance.fcloseFinalizer,
+  );
+  late final int descriptor;
+  late final Pointer<Void> _stream;
+  final Object _detach = Object();
+  bool _closed = false;
+
+  /// /proc/self/fd refers to the live owned anonymous inode, not a mutable
+  /// user pathname. Keep this owner alive until all reopened writers close.
+  String get path => '/proc/self/fd/$descriptor';
+
+  void close() {
+    if (_closed) return;
+    _closed = true;
+    _finalizer.detach(_detach);
+    _NativeFiles.instance.fclose(_stream);
+  }
+}
+
+class ArchiveExclusivePublisher {
+  ArchiveExclusivePublisher(
+    String destination, {
+    void Function(String)? onRootCreated,
+  }) {
+    _root = _NativeFiles.instance.openDirectory(
+      destination,
+      create: true,
+      onCreated: (path) => onRootCreated?.call('/$path'),
+    );
+  }
+  late final int _root;
+  bool _closed = false;
+
+  void publishDirectory(String relative, void Function(String) onCreated) {
+    final fd = _NativeFiles.instance.walk(
+      _root,
+      relative,
+      create: true,
+      onCreated: onCreated,
+    );
+    _NativeFiles.instance.close(fd);
+  }
+
+  void publishFile(
+    String relative,
+    ArchivePrivateFile staged,
+    void Function(String) onCreated,
+  ) {
+    final api = _NativeFiles.instance;
+    final parent = p.posix.dirname(relative);
+    final parentFd = api.walk(
+      _root,
+      parent,
+      create: true,
+      onCreated: onCreated,
+    );
+    int output = -1;
+    try {
+      output = api.withString(
+        p.posix.basename(relative),
+        (name) =>
+            api.openat(parentFd, name, 1 | 64 | 128 | 0x20000 | 0x80000, 384),
+      );
+      if (output < 0) {
+        api.fail('Exclusive archive publication refused', relative);
+      }
+      // Include incomplete outputs in a failure result as soon as created.
+      onCreated(relative);
+      final buffer = api.malloc(65536).cast<Uint8>();
+      if (buffer == nullptr) {
+        throw StateError('Publication buffer allocation failed');
+      }
+      RandomAccessFile? input;
+      try {
+        input = File(staged.path).openSync();
+        while (true) {
+          final bytes = input.readSync(65536);
+          if (bytes.isEmpty) break;
+          buffer.asTypedList(bytes.length).setAll(0, bytes);
+          var offset = 0;
+          while (offset < bytes.length) {
+            final count = api.write(
+              output,
+              buffer + offset,
+              bytes.length - offset,
+            );
+            if (count <= 0) {
+              api.fail('Archive publication write failed', relative);
+            }
+            offset += count;
+          }
+        }
+      } finally {
+        api.free(buffer.cast());
+        input?.closeSync();
+      }
+    } finally {
+      if (output >= 0) api.close(output);
+      api.close(parentFd);
+    }
+  }
+
+  void close() {
+    if (_closed) return;
+    _closed = true;
+    _NativeFiles.instance.close(_root);
+  }
+}
+
+class _NativeFiles {
+  _NativeFiles() {
+    if ((!Platform.isLinux && !Platform.isAndroid) ||
+        ![
+          Abi.linuxX64,
+          Abi.linuxArm64,
+          Abi.androidX64,
+          Abi.androidArm64,
+        ].contains(Abi.current())) {
+      throw UnsupportedError(
+        'Safe extraction publication requires Linux/Android descriptors',
+      );
+    }
+  }
+  static final instance = _NativeFiles();
+  final _lib = DynamicLibrary.process();
+  late final open = _lib
+      .lookupFunction<
+        Int32 Function(Pointer<Uint8>, Int32, Uint32),
+        int Function(Pointer<Uint8>, int, int)
+      >('open');
+  late final openat = _lib
+      .lookupFunction<
+        Int32 Function(Int32, Pointer<Uint8>, Int32, Uint32),
+        int Function(int, Pointer<Uint8>, int, int)
+      >('openat');
+  late final mkdirat = _lib
+      .lookupFunction<
+        Int32 Function(Int32, Pointer<Uint8>, Uint32),
+        int Function(int, Pointer<Uint8>, int)
+      >('mkdirat');
+  late final close = _lib
+      .lookupFunction<Int32 Function(Int32), int Function(int)>('close');
+  late final write = _lib
+      .lookupFunction<
+        IntPtr Function(Int32, Pointer<Uint8>, UintPtr),
+        int Function(int, Pointer<Uint8>, int)
+      >('write');
+  late final malloc = _lib
+      .lookupFunction<
+        Pointer<Void> Function(UintPtr),
+        Pointer<Void> Function(int)
+      >('malloc');
+  late final free = _lib
+      .lookupFunction<
+        Void Function(Pointer<Void>),
+        void Function(Pointer<Void>)
+      >('free');
+  late final fdopen = _lib
+      .lookupFunction<
+        Pointer<Void> Function(Int32, Pointer<Uint8>),
+        Pointer<Void> Function(int, Pointer<Uint8>)
+      >('fdopen');
+  late final fclose = _lib
+      .lookupFunction<
+        Int32 Function(Pointer<Void>),
+        int Function(Pointer<Void>)
+      >('fclose');
+  // fclose's return value is intentionally discarded by the finalizer ABI.
+  late final fcloseFinalizer = _lib
+      .lookup<NativeFunction<Void Function(Pointer<Void>)>>('fclose');
+  late final errno = _lib
+      .lookupFunction<Pointer<Int32> Function(), Pointer<Int32> Function()>(
+        Platform.isAndroid ? '__errno' : '__errno_location',
+      );
+
+  T withString<T>(String text, T Function(Pointer<Uint8>) body) {
+    final bytes = utf8.encode(text);
+    final pointer = malloc(bytes.length + 1).cast<Uint8>();
+    if (pointer == nullptr) throw StateError('Native path allocation failed');
+    try {
+      pointer.asTypedList(bytes.length + 1).setAll(0, [...bytes, 0]);
+      return body(pointer);
+    } finally {
+      free(pointer.cast());
+    }
+  }
+
+  Never fail(String message, [String? path]) {
+    final code = errno().value;
+    throw FileSystemException(
+      message,
+      path ?? '',
+      OSError('errno $code', code),
+    );
+  }
+
+  int openDirectory(
+    String path, {
+    required bool create,
+    void Function(String)? onCreated,
+  }) {
+    // The selected root may itself be an alias (for example /sdcard). Resolve
+    // its existing ancestor once, then retain no-follow directory descriptors.
+    // Paths originating in archive entries are never canonicalized this way.
+    var existing = p.normalize(p.absolute(path));
+    final missing = <String>[];
+    while (!Directory(existing).existsSync()) {
+      final parent = p.dirname(existing);
+      if (parent == existing) fail('Cannot resolve extraction root', path);
+      missing.insert(0, p.basename(existing));
+      existing = parent;
+    }
+    final canonical = Directory(existing).resolveSymbolicLinksSync();
+    final resolved = p.joinAll([canonical, ...missing]);
+    final root = withString(
+      '/',
+      (name) => open(name, 0x10000 | 0x20000 | 0x80000, 0),
+    );
+    if (root < 0) fail('Cannot open extraction root', path);
+    try {
+      return walk(
+        root,
+        resolved.replaceAll('\\', '/'),
+        create: create,
+        onCreated: onCreated,
+      );
+    } finally {
