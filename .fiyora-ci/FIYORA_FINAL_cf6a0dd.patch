+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:archive/archive_io.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nfile/services/archive_service.dart';
+import 'package:nfile/services/archive_input_entries.dart';
+import 'package:nfile/services/background_archive_service.dart';
+import 'package:path/path.dart' as p;
+
+Future<Map> _worker(
+  Future<void> Function(Map<String, dynamic>) entry,
+  Map<String, dynamic> args,
+) async {
+  final messages = ReceivePort();
+  Isolate? isolate;
+  try {
+    isolate = await Isolate.spawn(entry, {
+      ...args,
+      'sendPort': messages.sendPort,
+    }, onError: messages.sendPort);
+    final result = await messages
+        .firstWhere((event) {
+          return event is! Map ||
+              const {'completed', 'error', 'partial', 'cancelled'}.contains(event['status']);
+        })
+        .timeout(const Duration(seconds: 20));
+    if (result is! Map) throw StateError('$result');
+    return result;
+  } finally {
+    isolate?.kill(priority: Isolate.immediate);
+    messages.close();
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory fixture;
+
+  setUp(() {
+    fixture = Directory.systemTemp.createTempSync('ar014_');
+  });
+  tearDown(() => fixture.deleteSync(recursive: true));
+
+  for (final background in [false, true]) {
+    for (final format in ['zip', 'tar']) {
+      final label = '${background ? 'background' : 'direct'} $format';
+
+      Future<void> compress(List<String> sources, String destination) async {
+        if (background) {
+          final result =
+              await _worker(BackgroundArchiveService.compressIsolateTask, {
+                'sourcePaths': sources,
+                'destinationPath': destination,
+                'format': format,
+                'level': 6,
+                'deleteSource': false,
+              });
+          if (result['status'] != 'completed') throw StateError('$result');
+        } else {
+          await ArchiveService.createArchive(
+            sourcePaths: sources,
+            destinationDir: p.dirname(destination),
+            archiveName: p.basenameWithoutExtension(destination),
+            format: format,
+            compressionLevel: 6,
+            deleteSource: false,
+            separateArchives: false,
+          );
+        }
+      }
+
+      Archive readArchive(String path) {
+        final bytes = File(path).readAsBytesSync();
+        return format == 'zip'
+            ? ZipDecoder().decodeBytes(bytes)
+            : TarDecoder().decodeBytes(bytes);
+      }
+
+      Future<void> extract(String path, String destination) async {
+        if (background) {
+          final result = await _worker(
+            BackgroundArchiveService.extractIsolateTask,
+            {'archivePath': path, 'destinationDir': destination},
+          );
+          expect(result['status'], 'completed', reason: '$result');
+        } else {
+          await ArchiveService.extractArchive(
