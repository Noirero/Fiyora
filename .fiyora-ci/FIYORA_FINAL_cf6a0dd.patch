+      expect(outcome.archivePaths, [archivePath(first), archivePath(second)]);
+      expect(outcome.batchFailure, isNull);
+      expect(outcome.sourceCleanupFailures.single.path, first.path);
+      expect(outcome.toWorkerMessage()['reason'], 'sourceCleanupFailed');
+      expect(outcome.toWorkerMessage().containsKey('batchFailure'), isFalse);
+      expectArchive(first, 'KEEP');
+      expectArchive(second, 'SECOND');
+      expect(first.readAsStringSync(), 'KEEP');
+      expect(second.existsSync(), isFalse);
+    });
+
+    test('retry is explicit, refuses old outputs and can process only remaining items', () async {
+      final first = input('first.txt', 'FIRST');
+      final failed = input('failed.txt', 'FAILED');
+      final pending = input('pending.txt', 'PENDING');
+      denyReads(failed);
+      final partial = await create([first, failed, pending], deleteSource: false);
+      expect(partial.isPartial, isTrue);
