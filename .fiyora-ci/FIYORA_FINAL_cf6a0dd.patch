+          expect(
+            entries.map((f) => f.name.replaceAll(RegExp(r'/+$'), '')).toSet(),
+            {
+              'tree',
+              'tree/empty',
+              'tree/empty/nested',
+              'tree/資料',
+              'tree/資料/空',
+              'tree/data.txt',
+            },
+          );
+          expect(entries.where((f) => !f.isFile).length, 5);
+          expect(
+            entries.every(
+              (f) =>
+                  !p.posix.isAbsolute(f.name) &&
+                  !f.name.split('/').contains('..'),
+            ),
+            isTrue,
+          );
+          await extract(archive, output.path);
+          for (final name in ['tree/empty/nested', 'tree/資料/空']) {
+            final directory = Directory(p.join(output.path, name));
