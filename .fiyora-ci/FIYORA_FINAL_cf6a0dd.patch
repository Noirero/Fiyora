+          expect(
+            File(p.join(second.path, 'second.txt')).readAsStringSync(),
+            'SECOND',
+          );
+        },
+      );
+
+      test(
+        '$label rejects backslash source names that codecs would reinterpret',
+        () async {
+          if (Platform.isWindows) return;
+          final source = Directory(p.join(fixture.path, r'unsafe\..\escape'))
+            ..createSync();
+          File(p.join(source.path, 'keep.txt')).writeAsStringSync('KEEP');
+          final archive = p.join(fixture.path, 'unsafe.$format');
+          await expectLater(
+            compress([source.path], archive),
+            throwsA(
+              predicate<Object>(
+                (e) => e.toString().contains('Unsafe archive entry name'),
