+            expect(directory.listSync(), isEmpty);
+          }
+          expect(
+            File(p.join(output.path, 'tree/data.txt')).readAsStringSync(),
+            'KEEP CONTENT',
+          );
+        },
+      );
+
+      test('$label repeated selections emit no duplicate entries', () async {
+        final source = Directory(p.join(fixture.path, '資料'))..createSync();
+        Directory(p.join(source.path, 'empty')).createSync();
+        File(p.join(source.path, 'data.txt')).writeAsStringSync('DATA');
+        final archive = p.join(fixture.path, 'repeated.$format');
+        await compress([source.path, source.path], archive);
+        final entries = readArchive(archive).files;
+        expect(entries.length, 3);
+        expect(entries.map((f) => f.name).toSet().length, entries.length);
+      });
+
+      test(
+        '$label rejects colliding selected archive names without writing output',
+        () async {
+          final first = Directory(p.join(fixture.path, 'one', 'same'))
+            ..createSync(recursive: true);
+          final second = Directory(p.join(fixture.path, 'two', 'same'))
+            ..createSync(recursive: true);
+          File(p.join(first.path, 'first.txt')).writeAsStringSync('FIRST');
+          File(p.join(second.path, 'second.txt')).writeAsStringSync('SECOND');
+          final archive = p.join(fixture.path, 'conflict.$format');
+          await expectLater(
+            compress([first.path, second.path], archive),
+            throwsA(
+              predicate<Object>(
+                (e) => e.toString().contains('Conflicting archive entry name'),
+              ),
+            ),
+          );
+          expect(File(archive).existsSync(), isFalse);
+          expect(
+            File(p.join(first.path, 'first.txt')).readAsStringSync(),
+            'FIRST',
