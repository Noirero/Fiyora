+  });
+
+  test('nested symlinks are not followed outside the selected source', () {
+    if (Platform.isWindows) return;
+    final source = Directory(p.join(fixture.path, 'source'))..createSync();
+    final outside = Directory(p.join(fixture.path, 'outside'))..createSync();
+    File(p.join(outside.path, 'private.txt')).writeAsStringSync('OUTSIDE');
+    Link(p.join(source.path, 'linked')).createSync(outside.path);
+    final entries = collectArchiveInputEntries([source.path]);
+    expect(entries.map((entry) => entry.relPath), ['source']);
+    expect(entries.single.isDirectory, isTrue);
+  });
+}
diff --git a/test/archive_operation_ownership_test.dart b/test/archive_operation_ownership_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..503f0d0b293d06f01386ae482ffec30b81e81c89
--- /dev/null
+++ b/test/archive_operation_ownership_test.dart
@@ -0,0 +1,175 @@
+import 'dart:async';
+
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nfile/services/archive_operation_ownership.dart';
+
+void main() {
+  test('admission happens before an async spawn can yield', () async {
+    final ownership = ArchiveOperationOwnership();
+    final spawn = Completer<void>();
+    final attached = <String>[];
+
+    Future<ArchiveOperationLease> start(String kind) async {
+      final lease = ownership.acquire(kind);
+      await spawn.future;
+      if (ownership.owns(lease)) attached.add(lease.id);
+      return lease;
+    }
+
+    final first = start('compress');
+    final firstLease = ownership.active!;
+    await expectLater(
+      start('extract'),
+      throwsA(
+        isA<ArchiveOperationBusyException>().having(
+          (error) => error.activeOperationId,
+          'active operation ID',
+          firstLease.id,
+        ),
+      ),
+    );
+    expect(ownership.active, same(firstLease));
+    expect(attached, isEmpty);
+
+    spawn.complete();
+    expect(await first, same(firstLease));
+    expect(attached, [firstLease.id]);
+  });
+
+  test('a rejected start cannot replace operation state or resources', () {
+    final ownership = ArchiveOperationOwnership();
+    final first = ownership.acquire('compress');
+    final resourceOwners = <String, Object>{first.id: Object()};
+    final firstResources = resourceOwners[first.id];
+
+    expect(() {
+      final second = ownership.acquire('extract');
+      resourceOwners[second.id] = Object();
+    }, throwsA(isA<ArchiveOperationBusyException>()));
+    expect(resourceOwners.length, 1);
+    expect(resourceOwners[first.id], same(firstResources));
+    expect(ownership.owns(first), isTrue);
+  });
+
+  test('requested cancellation retains admission until worker exit', () async {
+    final ownership = ArchiveOperationOwnership();
+    final first = ownership.acquire('extract');
+    final workerExit = Completer<void>();
+    var cancelRequested = false;
+
+    Future<void> cancelAndWaitForExit() async {
+      cancelRequested = true;
+      await workerExit.future;
+      ownership.release(first);
+    }
+
+    final cancellation = cancelAndWaitForExit();
+    expect(cancelRequested, isTrue);
+    expect(ownership.isBusy, isTrue);
+    expect(
+      () => ownership.acquire('compress'),
+      throwsA(isA<ArchiveOperationBusyException>()),
+    );
+    workerExit.complete();
+    await cancellation;
+    expect(ownership.isBusy, isFalse);
+    final second = ownership.acquire('compress');
+    expect(ownership.owns(second), isTrue);
+    expect(second.id, isNot(first.id));
+  });
+
+  test('late completion cannot release a later operation', () {
+    final ownership = ArchiveOperationOwnership();
+    final first = ownership.acquire('extract');
+    expect(ownership.release(first), isTrue);
+    final second = ownership.acquire('compress');
+
+    expect(ownership.release(first), isFalse);
+    expect(ownership.active, same(second));
+    expect(ownership.owns(second), isTrue);
+    expect(ownership.owns(first), isFalse);
+  });
+
+  test('stale progress and resource cleanup are ignored after replacement', () {
+    final ownership = ArchiveOperationOwnership();
+    final first = ownership.acquire('compress');
+    var visibleProgress = 0.0;
+    Object? isolateOwner = first;
+    Object? receivePortOwner = first;
+
+    void onProgress(ArchiveOperationLease lease, double progress) {
+      if (!ownership.owns(lease)) return;
+      visibleProgress = progress;
+    }
+
+    void onExit(ArchiveOperationLease lease) {
+      if (!ownership.owns(lease)) return;
+      isolateOwner = null;
+      receivePortOwner = null;
+      ownership.release(lease);
+    }
+
+    onExit(first);
+    final second = ownership.acquire('extract');
+    isolateOwner = second;
+    receivePortOwner = second;
+    onProgress(second, 0.4);
+
+    onProgress(first, 1.0);
+    onExit(first);
+    expect(visibleProgress, 0.4);
+    expect(isolateOwner, same(second));
+    expect(receivePortOwner, same(second));
+    expect(ownership.active, same(second));
+  });
+
+  test('foreign ownership objects cannot clear another coordinator', () {
+    final firstOwner = ArchiveOperationOwnership();
+    final secondOwner = ArchiveOperationOwnership();
+    final first = firstOwner.acquire('extract');
+    final second = secondOwner.acquire('extract');
+
+    expect(firstOwner.release(second), isFalse);
+    expect(secondOwner.release(first), isFalse);
+    expect(firstOwner.active, same(first));
+    expect(secondOwner.active, same(second));
+    expect(first.id, isNot(second.id));
+  });
+
+  test('release is idempotent and enables an explicit retry', () {
+    final ownership = ArchiveOperationOwnership();
+    final first = ownership.acquire('extract');
+    expect(ownership.release(first), isTrue);
+    expect(ownership.release(first), isFalse);
+    final retry = ownership.acquire('extract');
+    expect(retry.id, isNot(first.id));
+    expect(ownership.release(first), isFalse);
+    expect(ownership.active, same(retry));
+  });
+
+  test('a burst of starts admits exactly one operation', () async {
+    final ownership = ArchiveOperationOwnership();
+    final accepted = <ArchiveOperationLease>[];
+    final rejected = <ArchiveOperationBusyException>[];
+    await Future.wait(
+      List.generate(
+        20,
+        (index) => Future<void>(() {
+          try {
+            accepted.add(
+              ownership.acquire(index.isEven ? 'compress' : 'extract'),
+            );
+          } on ArchiveOperationBusyException catch (error) {
+            rejected.add(error);
+          }
+        }),
+      ),
+    );
+    expect(accepted.length, 1);
+    expect(rejected.length, 19);
+    expect(rejected.map((error) => error.activeOperationId).toSet(), {
+      accepted.single.id,
+    });
+    expect(ownership.active, same(accepted.single));
+  });
+}
