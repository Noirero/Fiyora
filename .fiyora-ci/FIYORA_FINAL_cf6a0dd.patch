+  int walk(
+    int root,
+    String relative, {
+    required bool create,
+    void Function(String)? onCreated,
+  }) {
+    var current = withString(
+      '.',
+      (name) => openat(root, name, 0x10000 | 0x20000 | 0x80000, 0),
+    );
+    if (current < 0) fail('Cannot retain extraction directory', relative);
+    var prefix = '';
+    try {
+      for (final part
+          in relative
+              .split('/')
+              .where((part) => part.isNotEmpty && part != '.')) {
+        if (part == '..') {
+          throw FileSystemException('Parent traversal refused', relative);
+        }
+        prefix = prefix.isEmpty ? part : '$prefix/$part';
+        var next = withString(
+          part,
+          (name) => openat(current, name, 0x10000 | 0x20000 | 0x80000, 0),
+        );
+        if (next < 0 && create) {
+          final made = withString(part, (name) => mkdirat(current, name, 448));
