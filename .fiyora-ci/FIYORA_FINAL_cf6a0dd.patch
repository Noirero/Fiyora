+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:isolate';
+
+import 'package:archive/archive_io.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nfile/services/archive_extraction.dart';
+import 'package:nfile/services/archive_operation_ownership.dart';
+import 'package:nfile/services/archive_service.dart';
+import 'package:nfile/services/archive_worker_lifecycle.dart';
+import 'package:nfile/services/background_archive_service.dart';
+
+// Exercise the real coordinator + real extraction pipeline in a real isolate.
+// Only the boundary gate is injected, to choose cancellation/publication order.
+void _controlledExtraction(Map<String, dynamic> args) async {
+  final events = args['sendPort'] as SendPort;
+  final barrier = args['barrier'] as SendPort;
+  final control = ReceivePort();
+  final gate = Completer<void>();
+  var cancelled = false;
+  var paused = false;
+  control.listen((message) {
+    if (message is! Map) return;
+    if (message['command'] == 'cancel' &&
+        message['operationId'] == args['operationId']) {
+      cancelled = true;
+      if (!gate.isCompleted) gate.complete();
+    } else if (message['command'] == 'continue' && !gate.isCompleted) {
+      gate.complete();
+    }
+  });
+  events.send({
+    'status': 'control',
+    'sendPort': control.sendPort,
+    'operationId': args['operationId'],
+  });
+  // FIFO on this one SendPort proves the coordinator consumed control first.
+  events.send({
+    'status': 'progress',
+    'progress': 0.0,
+    'currentFile': 'controlled-ready',
+    'operationId': args['operationId'],
+  });
+  try {
+    await ArchiveExtraction.extract(
+      archivePath: args['archivePath'] as String,
+      destinationDir: args['destinationDir'] as String,
+      background: true,
+      isCancelled: () => cancelled,
+      onBoundary: (phase, paths) async {
+        if (!paused && phase == args['pauseAt']) {
+          paused = true;
+          barrier.send({'control': control.sendPort, 'paths': paths});
+          await gate.future;
+        }
+      },
+    );
+    events.send({'status': 'completed'});
+  } on ArchiveExtractionFailure catch (error) {
+    events.send({
+      'status': error.isPartial
+          ? 'partial'
+          : error.cancelled
+          ? 'cancelled'
+          : 'error',
+      'cancelled': error.cancelled,
+      'publishedPaths': error.publishedPaths,
+      'error': error.toString(),
+    });
+  } catch (error) {
+    events.send({'status': 'error', 'error': '$error'});
+  } finally {
+    control.close();
+  }
+}
+
+Future<void> _controlledReady(BackgroundArchiveService service) async {
+  final ready = Completer<void>();
+  void listener() {
+    if (service.activeOperation.value?.currentFile == 'controlled-ready' &&
+        !ready.isCompleted) {
+      ready.complete();
+    }
+  }
+
+  service.activeOperation.addListener(listener);
+  try {
+    listener();
+    await ready.future.timeout(const Duration(seconds: 20));
+  } finally {
+    service.activeOperation.removeListener(listener);
+  }
+}
+
+Future<void> _exited(BackgroundArchiveService service) async {
+  if (service.activeOperation.value == null) return;
+  final done = Completer<void>();
+  void listener() {
+    if (service.activeOperation.value == null && !done.isCompleted) {
+      done.complete();
+    }
+  }
+
+  service.activeOperation.addListener(listener);
+  try {
+    await done.future.timeout(const Duration(seconds: 20));
+  } finally {
+    service.activeOperation.removeListener(listener);
+  }
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory fixture;
+  late Directory destination;
+  late File input;
+
+  setUp(() {
+    fixture = Directory.systemTemp.createTempSync('fiyora_combined_');
+    destination = Directory('${fixture.path}/out')..createSync();
+    final archive = Archive()
+      ..addFile(ArchiveFile('first.txt', 5, utf8.encode('FIRST')))
+      ..addFile(ArchiveFile('second.txt', 6, utf8.encode('SECOND')));
+    input = File('${fixture.path}/input.zip')
+      ..writeAsBytesSync(ZipEncoder().encode(archive)!);
+  });
+  tearDown(() => fixture.deleteSync(recursive: true));
+
+  for (final phase in ['staging', 'published']) {
+    test(
+      'cancel during $phase preserves publication and holds ownership until exit',
+      () async {
+        final service = BackgroundArchiveService.forTesting();
+        final barrier = ReceivePort();
+        try {
+          await service.startWorkerForTesting(
+            task: _controlledExtraction,
+            arguments: {
+              'archivePath': input.path,
+              'destinationDir': destination.path,
+              'pauseAt': phase,
+              'barrier': barrier.sendPort,
+            },
+          );
+          final reached =
+              await barrier.first.timeout(const Duration(seconds: 20)) as Map;
+          await _controlledReady(service);
+          final originalId = service.activeOperation.value!.id;
+          await expectLater(
+            service.startWorkerForTesting(
+              task: BackgroundArchiveService.extractIsolateTask,
+            ),
+            throwsA(isA<ArchiveOperationBusyException>()),
+          );
+          final stopped = _exited(service);
+          service.cancelOperation(operationId: originalId);
+          expect(service.activeOperation.value!.isCancelling, isTrue);
+          await expectLater(
+            service.startWorkerForTesting(
+              task: BackgroundArchiveService.extractIsolateTask,
+            ),
+            throwsA(isA<ArchiveOperationBusyException>()),
+          );
+          await stopped;
+          expect(service.lastWorkerOutcome!.workerExitConfirmed, isTrue);
+          final first = File('${destination.path}/first.txt');
+          if (phase == 'published') {
+            expect(
+              service.lastWorkerOutcome!.phase,
+              ArchiveWorkerPhase.partial,
+            );
+            expect(
+              service.lastWorkerOutcome!.terminalMessage!['cancelled'],
+              isTrue,
+            );
+            expect(reached['paths'], contains(first.path));
+            expect(first.readAsStringSync(), 'FIRST');
+            expect(
+              File('${destination.path}/second.txt').existsSync(),
+              isFalse,
+            );
+          } else {
+            expect(
+              service.lastWorkerOutcome!.phase,
+              ArchiveWorkerPhase.cancelConfirmed,
+            );
+            expect(destination.listSync(), isEmpty);
+          }
+
+          // Explicit retry through the production worker: partial collision is
+          // reported, and prior output is kept. A pre-publication cancel retries.
+          final retried = service.startWorkerForTesting(
+            task: BackgroundArchiveService.extractIsolateTask,
+            arguments: {
+              'archivePath': input.path,
+              'destinationDir': destination.path,
+            },
+          );
+          final retryId = service.activeOperation.value!.id;
+          service.handleNotificationCancellation({'operationId': originalId});
+          expect(service.activeOperation.value!.isCancelling, isFalse);
+          expect(retryId, isNot(originalId));
+          final retryExited = _exited(service);
+          await retried;
+          await retryExited;
+          expect(
+            service.lastWorkerOutcome!.phase,
+            phase == 'published'
+                ? ArchiveWorkerPhase.failed
+                : ArchiveWorkerPhase.completed,
+          );
+          expect(first.readAsStringSync(), 'FIRST');
+        } finally {
+          barrier.close();
+        }
+      },
+    );
+  }
+
+  test(
+    'publication collision preserves foreign data and permits explicit retry elsewhere',
+    () async {
+      final service = BackgroundArchiveService.forTesting();
+      final barrier = ReceivePort();
+      try {
+        await service.startWorkerForTesting(
+          task: _controlledExtraction,
+          arguments: {
+            'archivePath': input.path,
+            'destinationDir': destination.path,
+            'pauseAt': 'publishing',
+            'barrier': barrier.sendPort,
+          },
+        );
+        final reached =
+            await barrier.first.timeout(const Duration(seconds: 20)) as Map;
+        final foreign = File('${destination.path}/first.txt')
+          ..writeAsStringSync('FOREIGN');
+        final stopped = _exited(service);
+        (reached['control'] as SendPort).send({'command': 'continue'});
+        await stopped;
+        expect(service.lastWorkerOutcome!.phase, ArchiveWorkerPhase.failed);
+        expect(foreign.readAsStringSync(), 'FOREIGN');
+        expect(File('${destination.path}/second.txt').existsSync(), isFalse);
+        final retry = Directory('${fixture.path}/retry')..createSync();
+        final starting = service.startWorkerForTesting(
+          task: BackgroundArchiveService.extractIsolateTask,
+          arguments: {'archivePath': input.path, 'destinationDir': retry.path},
+        );
+        final retryExited = _exited(service);
+        await starting;
+        await retryExited;
+        expect(service.lastWorkerOutcome!.phase, ArchiveWorkerPhase.completed);
+        expect(File('${retry.path}/first.txt').readAsStringSync(), 'FIRST');
+        expect(foreign.readAsStringSync(), 'FOREIGN');
+      } finally {
+        barrier.close();
+      }
+    },
+  );
+
+  test(
+    'archive creation success and source cleanup failure survive coordinator completion',
+    () async {
+      final sourceDir = Directory('${fixture.path}/protected')..createSync();
+      final source = File('${sourceDir.path}/source.txt')
+        ..writeAsStringSync('KEEP');
+      expect(Process.runSync('chmod', ['0555', sourceDir.path]).exitCode, 0);
+      try {
+        final output = '${fixture.path}/created.zip';
+        final service = BackgroundArchiveService.forTesting();
+        final starting = service.startWorkerForTesting(
+          task: BackgroundArchiveService.compressIsolateTask,
+          arguments: {
+            'sourcePaths': [source.path],
+            'destinationPath': output,
+            'format': 'zip',
+            'level': 6,
+            'deleteSource': true,
+          },
+        );
+        final stopped = _exited(service);
+        await starting;
+        await stopped;
+        expect(service.lastWorkerOutcome!.phase, ArchiveWorkerPhase.partial);
+        expect(
+          service.lastWorkerOutcome!.terminalMessage!['archiveCreated'],
+          isTrue,
+        );
+        expect(
+          service.lastWorkerOutcome!.terminalMessage!['reason'],
+          'sourceCleanupFailed',
+        );
+        expect(source.readAsStringSync(), 'KEEP');
+        final archive = ZipDecoder().decodeBytes(
+          File(output).readAsBytesSync(),
+        );
+        expect(archive.files.single.content, utf8.encode('KEEP'));
+      } finally {
+        Process.runSync('chmod', ['0755', sourceDir.path]);
+      }
+    },
+  );
+
+  for (final format in ['zip', 'tar']) {
+    test(
+      'combined $format creation and staged extraction retain nested empty Unicode directories',
+      () async {
+        final source = Directory('${fixture.path}/資料')..createSync();
+        Directory('${source.path}/kosong/空').createSync(recursive: true);
+        File('${source.path}/data.txt').writeAsStringSync('DATA');
