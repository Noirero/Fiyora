+import 'dart:convert';
+import 'dart:io';
+
+import 'package:archive/archive_io.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nfile/services/archive_creation_outcome.dart';
+import 'package:nfile/services/archive_service.dart';
+import 'package:path/path.dart' as p;
+
+// Added during the static-only follow-up; execution was deferred at authoring.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  group('separate archive partial-batch outcomes', () {
+    late Directory fixture;
+    late Directory output;
+
+    setUp(() {
+      fixture = Directory.systemTemp.createTempSync('ar015_batch_');
+      output = Directory(p.join(fixture.path, 'output'))..createSync();
+    });
+
+    tearDown(() {
+      // Fixtures deny file reads or parent writes, never directory traversal.
+      for (final entity in fixture.listSync(recursive: true, followLinks: false)) {
+        Process.runSync('chmod', [entity is Directory ? '0755' : '0644', entity.path]);
+      }
+      fixture.deleteSync(recursive: true);
+    });
+
+    File input(String name, String contents, {Directory? parent}) =>
+        File(p.join((parent ?? fixture).path, name))..writeAsStringSync(contents);
+
+    String archivePath(File source) =>
+        p.join(output.path, '${p.basenameWithoutExtension(source.path)}.zip');
+
+    void denyReads(File file) {
+      final result = Process.runSync('chmod', ['0000', file.path]);
+      expect(result.exitCode, 0, reason: result.stderr.toString());
+      expect(() => file.readAsBytesSync(), throwsA(isA<FileSystemException>()),
+          reason: 'The fixture requires an unprivileged Linux executor');
+    }
+
+    void denyCleanup(Directory directory, File source) {
+      final result = Process.runSync('chmod', ['0555', directory.path]);
+      expect(result.exitCode, 0, reason: result.stderr.toString());
+      expect(() => source.deleteSync(), throwsA(isA<FileSystemException>()));
+    }
+
+    Future<ArchiveCreationOutcome> create(List<File> sources, {bool deleteSource = true}) =>
+        ArchiveService.createArchive(
+          sourcePaths: sources.map((file) => file.path).toList(),
+          destinationDir: output.path,
+          archiveName: 'unused',
+          format: 'zip',
+          compressionLevel: 6,
+          deleteSource: deleteSource,
+          separateArchives: true,
+        );
+
+    void expectArchive(File source, String contents) {
+      final archive = ZipDecoder().decodeBytes(File(archivePath(source)).readAsBytesSync());
+      expect(archive.files.single.name, p.basename(source.path));
+      expect(archive.files.single.content, utf8.encode(contents));
+    }
+
+    for (final deleteSource in [false, true]) {
+      test('first creation failure still throws, deleteSource=$deleteSource', () async {
+        final failed = input('failed.txt', 'FAILED');
+        final pending = input('pending.txt', 'PENDING');
+        denyReads(failed);
+
+        await expectLater(
+          create([failed, pending], deleteSource: deleteSource),
+          throwsA(isA<FileSystemException>().having((error) => error.path, 'source path', failed.path)),
+        );
+
+        expect(output.listSync(), isEmpty);
+        expect(failed.existsSync(), isTrue);
+        expect(Process.runSync('chmod', ['0644', failed.path]).exitCode, 0);
+        expect(failed.readAsStringSync(), 'FAILED');
+        expect(pending.readAsStringSync(), 'PENDING');
+      });
+
+      test('later failure retains multiple outputs, deleteSource=$deleteSource', () async {
+        final first = input('first.txt', 'FIRST');
+        final second = input('second.txt', 'SECOND');
+        final failed = input('failed.txt', 'FAILED');
+        final pending = input('pending.txt', 'PENDING');
+        denyReads(failed);
+
+        final outcome = await create([first, second, failed, pending], deleteSource: deleteSource);
+
+        expect(outcome.archivePaths, [archivePath(first), archivePath(second)]);
+        expect(outcome.archiveCreated, isTrue);
+        expect(outcome.isPartial, isTrue);
+        expect(outcome.sourceCleanupFailures, isEmpty);
+        expect(outcome.batchFailure!.sourcePath, failed.path);
+        expect(outcome.batchFailure!.archivePath, archivePath(failed));
+        expect(outcome.batchFailure!.error, isA<FileSystemException>());
+        expect(outcome.batchFailure!.stackTrace.toString(), isNotEmpty);
+        expect(outcome.message, contains(outcome.batchFailure!.error.toString()));
+        expect(outcome.message, contains('batch stopped'));
+        expect(outcome.message, isNot(contains('created successfully')));
+        final message = outcome.toWorkerMessage();
+        expect(message['status'], 'partial');
+        expect(message['reason'], 'batchCreationFailed');
+        expect((message['batchFailure'] as Map)['error'], outcome.batchFailure!.error.toString());
+        expectArchive(first, 'FIRST');
+        expectArchive(second, 'SECOND');
+        expect(first.existsSync(), !deleteSource);
+        expect(second.existsSync(), !deleteSource);
+        expect(failed.existsSync(), isTrue);
+        expect(Process.runSync('chmod', ['0644', failed.path]).exitCode, 0);
+        expect(failed.readAsStringSync(), 'FAILED');
+        expect(pending.readAsStringSync(), 'PENDING');
+        expect(File(archivePath(failed)).existsSync(), isFalse);
+        expect(File(archivePath(pending)).existsSync(), isFalse);
+      });
+    }
+
+    test('earlier cleanup failure survives a later creation failure', () async {
