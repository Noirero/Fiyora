new file mode 100644
index 0000000000000000000000000000000000000000..4d4efcfd450d2497a70061bd768d3f878ebd9769
--- /dev/null
+++ b/lib/services/archive_operation_ownership.dart
@@ -0,0 +1,63 @@
+import 'dart:math';
+
+/// One lease for one background operation, retained until its worker has exited.
+///
+/// The lease object is the callback identity. The ID is for messages and Android
+/// notifications; it must not be reused as ownership of an older lease.
+class ArchiveOperationLease {
+  ArchiveOperationLease._(this.id);
+
+  final String id;
+}
+
+class ArchiveOperationBusyException implements Exception {
+  ArchiveOperationBusyException(this.activeOperationId);
+
+  final String activeOperationId;
+
+  @override
+  String toString() =>
+      'Another archive operation is still active: $activeOperationId';
+}
+
+/// Synchronous admission and identity checks for a single background worker.
+///
+/// Acquire before the first await or externally observable state change. A
+/// cancellation request does not release the lease: callers retain it until
+/// spawn failure or actual worker exit is acknowledged. Every callback must
+/// check [owns] before changing operation-specific state or resources.
+class ArchiveOperationOwnership {
+  final String _sessionId = _newSessionId();
+  int _serial = 0;
+  ArchiveOperationLease? _active;
+
+  ArchiveOperationLease? get active => _active;
+  bool get isBusy => _active != null;
+
+  ArchiveOperationLease acquire(String kind) {
+    final existing = _active;
+    if (existing != null) {
+      throw ArchiveOperationBusyException(existing.id);
+    }
+    final lease = ArchiveOperationLease._('$kind-$_sessionId-${++_serial}');
+    _active = lease;
+    return lease;
+  }
+
+  bool owns(ArchiveOperationLease lease) => identical(_active, lease);
+
+  /// A late completion/exit may never release a later operation's lease.
+  bool release(ArchiveOperationLease lease) {
+    if (!owns(lease)) return false;
+    _active = null;
+    return true;
+  }
+
+  static String _newSessionId() {
+    final random = Random.secure();
+    return List.generate(
+      16,
+      (_) => random.nextInt(256).toRadixString(16).padLeft(2, '0'),
+    ).join();
+  }
+}
