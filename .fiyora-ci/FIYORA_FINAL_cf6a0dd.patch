+          ).createSync(recursive: true);
+          Directory(p.join(source.path, '資料', '空')).createSync(recursive: true);
+          File(
+            p.join(source.path, 'data.txt'),
+          ).writeAsStringSync('KEEP CONTENT');
+          final archive = p.join(fixture.path, 'tree.$format');
