+
+  test(
+    'TAR PAX path records use UTF-8 byte lengths and retain long Unicode names',
+    () {
+      final name = '資料/${List.filled(50, '空').join()}/';
+      final archive = Archive()
+        ..addFile(ArchiveFile(name, 0, <int>[])..isFile = false)
+        ..addFile(ArchiveFile('資料/second/', 0, <int>[])..isFile = false);
