+import 'package:path/path.dart' as p;
+
+final class _NativeIO extends IOOverrides {}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+  late Directory fixture;
+  late Directory locked;
+  late Directory output;
+  late File source;
+
+  setUp(() {
+    fixture = Directory.systemTemp.createTempSync('ar015_');
+    locked = Directory(p.join(fixture.path, 'locked'))..createSync();
+    output = Directory(p.join(fixture.path, 'output'))..createSync();
+    source = File(p.join(locked.path, 'source.txt'))
+      ..writeAsStringSync('SOURCE');
+  });
+
+  tearDown(() {
+    Process.runSync('chmod', ['0755', locked.path]);
+    fixture.deleteSync(recursive: true);
+  });
+
+  void denySourceDeletion() {
+    final result = Process.runSync('chmod', ['0555', locked.path]);
+    expect(result.exitCode, 0, reason: result.stderr.toString());
+    // Verify the fixture really denies deletion on this executor.
+    final probe = File(p.join(locked.path, 'source.txt'));
+    expect(() => probe.deleteSync(), throwsA(isA<FileSystemException>()));
+    expect(source.readAsStringSync(), 'SOURCE');
+  }
+
+  Future<Map> compressInWorker(List<String> sources, String destination) async {
+    final port = ReceivePort();
+    Isolate? worker;
+    try {
+      worker = await Isolate.spawn(
+        BackgroundArchiveService.compressIsolateTask,
+        <String, dynamic>{
+          'sendPort': port.sendPort,
+          'sourcePaths': sources,
+          'destinationPath': destination,
+          'format': 'zip',
+          'level': 6,
+          'deleteSource': true,
+        },
+      );
+      return await port
+              .firstWhere(
+                (event) =>
+                    event is Map &&
+                    ['completed', 'partial', 'error'].contains(event['status']),
+              )
+              .timeout(const Duration(seconds: 30))
+          as Map;
+    } finally {
+      worker?.kill(priority: Isolate.immediate);
+      port.close();
+    }
+  }
+
+  Future<T> withInaccessibleCleanupMetadata<T>(
+    String destination,
+    Future<T> Function() operation,
+  ) async {
+    final native = _NativeIO();
+    var failedLookups = 0;
+    final result = await IOOverrides.runZoned(
+      () async {
+        final result = await operation();
+        // Prove this fixture represents denied metadata access, not an absent
+        // source. typeSync may collapse that failure to notFound on real I/O.
+        expect(
+          () => FileStat.statSync(source.path),
+          throwsA(isA<FileSystemException>()),
+        );
+        return result;
+      },
+      fseGetTypeSync: (path, followLinks) {
+        if (path == source.path && File(destination).existsSync()) {
+          failedLookups++;
+          return FileSystemEntityType.notFound;
+        }
+        return native.fseGetTypeSync(path, followLinks);
+      },
+      statSync: (path) {
+        if (path == source.path && File(destination).existsSync()) {
+          throw FileSystemException(
+            'Permission denied',
+            path,
+            const OSError('Permission denied', 13),
+          );
+        }
+        return native.statSync(path);
+      },
+    );
+    expect(failedLookups, greaterThan(0));
+    return result;
+  }
