index 0000000000000000000000000000000000000000..5eff5b88fc24236eb91203a7db16a299bb56cbef
--- /dev/null
+++ b/test/archive_cancellation_acknowledgement_test.dart
@@ -0,0 +1,461 @@
+import 'dart:async';
+import 'dart:isolate';
+
+import 'package:flutter/widgets.dart';
+import 'package:flutter_test/flutter_test.dart';
+import 'package:nfile/services/archive_operation_ownership.dart';
+import 'package:nfile/services/archive_worker_lifecycle.dart';
+import 'package:nfile/services/background_archive_service.dart';
+
+class _FakeWorker implements ArchiveWorkerHandle {
+  var kills = 0;
+  bool failResume = false;
+  @override
+  void resume() {
+    if (failResume) throw StateError("injected resume failure");
+  }
+
+  @override
+  void kill() => kills++;
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+class _PendingSpawn {
+  _PendingSpawn(this.events);
+  final SendPort events;
+  final result = Completer<ArchiveWorkerHandle>();
+  final worker = _FakeWorker();
+  void attach() => result.complete(worker);
+  void send(Map<String, dynamic> event) => events.send(event);
+  void exit() => events.send(null);
+}
+
+class _Spawner {
+  final pending = <_PendingSpawn>[];
+  Future<ArchiveWorkerHandle> spawn(
+    void Function(Map<String, dynamic>) task,
+    Map<String, dynamic> arguments,
+    SendPort events,
+  ) {
+    final request = _PendingSpawn(events);
+    pending.add(request);
+    return request.result.future;
+  }
+}
+
+class _UnmountedContext implements BuildContext {
+  @override
+  bool get mounted => false;
+  @override
+  dynamic noSuchMethod(Invocation invocation) => super.noSuchMethod(invocation);
+}
+
+void _unusedTask(Map<String, dynamic> args) {}
+
+void _cooperativeWorker(Map<String, dynamic> args) {
+  final events = args['sendPort'] as SendPort;
+  final ready = args['readyPort'] as SendPort;
+  final control = ReceivePort();
+  events.send({'status': 'control', 'sendPort': control.sendPort});
+  events.send({
+    'status': 'progress',
+    'progress': 0.0,
+    'currentFile': 'ready-for-cancel',
+  });
+  ready.send(true);
+  control.listen((message) {
+    if (message is Map && message['command'] == 'cancel') {
+      events.send({'status': 'cancelled'});
+      control.close();
+    }
+  });
+}
+
+void _completedWorker(Map<String, dynamic> args) {
+  (args['sendPort'] as SendPort).send({'status': 'completed'});
+}
+
+Future<void> _drainEvents() => Future<void>.delayed(Duration.zero);
+
+Future<void> _untilExited(BackgroundArchiveService service) {
+  if (service.activeOperation.value == null) return Future.value();
+  final done = Completer<void>();
+  void changed() {
+    if (service.activeOperation.value == null && !done.isCompleted) {
+      done.complete();
+    }
+  }
+
+  service.activeOperation.addListener(changed);
+  return done.future
+      .timeout(const Duration(seconds: 15))
+      .whenComplete(() => service.activeOperation.removeListener(changed));
+}
+
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  test(
+    'cancel requested, stop dispatched, and exit confirmed are distinct',
+    () {
+      final lifecycle = ArchiveWorkerLifecycle('A');
+      expect(lifecycle.requestCancellation('A'), isTrue);
+      expect(lifecycle.phase, ArchiveWorkerPhase.cancelRequested);
+      expect(lifecycle.workerExitConfirmed, isFalse);
+      lifecycle.workerAttached(willRun: false);
+      lifecycle.workerStopDispatched();
+      expect(lifecycle.phase, ArchiveWorkerPhase.workerExiting);
+      expect(lifecycle.workerExitConfirmed, isFalse);
+      lifecycle.confirmWorkerExit();
+      expect(lifecycle.phase, ArchiveWorkerPhase.cancelConfirmed);
+      expect(lifecycle.workerExitConfirmed, isTrue);
+    },
+  );
+
+  test('wrong identity and post-completion cancel are rejected', () {
+    final lifecycle = ArchiveWorkerLifecycle('A');
+    expect(lifecycle.requestCancellation('stale'), isFalse);
+    lifecycle.receiveTerminal({'status': 'completed'});
+    expect(lifecycle.requestCancellation('A'), isFalse);
+    expect(lifecycle.workerExitConfirmed, isFalse);
+    lifecycle.confirmWorkerExit();
+    expect(lifecycle.phase, ArchiveWorkerPhase.completed);
+  });
+
+  test(
+    'exit after running cancellation without worker result is uncertain',
+    () {
+      final lifecycle = ArchiveWorkerLifecycle('A')..workerAttached();
+      lifecycle.requestCancellation('A');
+      lifecycle.workerStopDispatched();
+      lifecycle.confirmWorkerExit();
+      expect(lifecycle.workerExitConfirmed, isTrue);
+      expect(lifecycle.phase, ArchiveWorkerPhase.interrupted);
+      expect(lifecycle.terminalMessage, isNull);
+    },
+  );
+
+  test('unexpected worker exit is a failure, not success or cancellation', () {
+    final lifecycle = ArchiveWorkerLifecycle('A')..workerAttached();
+    lifecycle.confirmWorkerExit();
+    expect(lifecycle.phase, ArchiveWorkerPhase.failed);
+  });
+
+  test(
+    'pending spawn cancellation retains active operation until onExit',
+    () async {
+      final spawner = _Spawner();
+      final service = BackgroundArchiveService.forTesting(
+        spawnWorker: spawner.spawn,
+      );
+      final starting = service.startWorkerForTesting(task: _unusedTask);
+      final operation = service.activeOperation.value!;
+      service.cancelOperation(operationId: operation.id);
+      expect(operation.phase, ArchiveWorkerPhase.cancelRequested);
+      expect(service.activeOperation.value, same(operation));
+      final pending = spawner.pending.single;
+      pending.attach();
+      await starting;
+      expect(pending.worker.kills, 1);
+      expect(operation.phase, ArchiveWorkerPhase.workerExiting);
+      expect(service.lastWorkerOutcome, isNull);
+      expect(service.activeOperation.value, same(operation));
+      final exited = _untilExited(service);
+      pending.exit();
+      await exited;
+      expect(
+        service.lastWorkerOutcome!.phase,
+        ArchiveWorkerPhase.cancelConfirmed,
+      );
+    },
+  );
+
+  test(
