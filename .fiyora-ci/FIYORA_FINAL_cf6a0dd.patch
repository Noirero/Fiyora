+    },
+  );
+
+  test('generated Unicode TAR is readable by the system tar tool', () {
+    if (!Platform.isLinux) return;
+    final archive = Archive()
+      ..addFile(ArchiveFile('資料/空/', 0, <int>[])..isFile = false)
+      ..addFile(ArchiveFile('資料/内容.txt', 4, utf8.encode('DATA')));
+    final file = File(p.join(fixture.path, 'pax.tar'))
+      ..writeAsBytesSync(encodeTarArchiveEntries(archive));
+    final result = Process.runSync('tar', ['-tf', file.path]);
+    expect(result.exitCode, 0, reason: '${result.stderr}');
+    expect(
+      (result.stdout as String).split('\n').where((name) => name.isNotEmpty),
+      ['資料/空/', '資料/内容.txt'],
