index 0000000000000000000000000000000000000000..13e71ab0309ab977d281799d9be724263eade00a
--- /dev/null
+++ b/lib/services/archive_input_entries.dart
@@ -0,0 +1,132 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:archive/archive.dart';
+import 'package:path/path.dart' as p;
+
+/// A selected source's portable relative archive name and filesystem entity.
+class ArchiveInputEntry {
+  ArchiveInputEntry(this.fullPath, this.relPath, {required this.isDirectory});
+
+  final String fullPath;
+  final String relPath;
+  final bool isDirectory;
+
+  ArchiveFile read() {
+    if (isDirectory) {
+      return ArchiveFile('$relPath/', 0, <int>[])
+        ..isFile = false
+        ..mode = 0x41ed; // Directory with ordinary 0755 permissions.
+    }
+    final bytes = File(fullPath).readAsBytesSync();
+    return ArchiveFile(relPath, bytes.length, bytes);
+  }
+}
+
+/// Include explicit directory entries, including selected empty roots.
+///
+/// Repeated selections of the same source/name are harmless. Different sources
+/// with the same archive name fail rather than silently replacing an entry.
+List<ArchiveInputEntry> collectArchiveInputEntries(List<String> sourcePaths) {
+  final entries = <String, ArchiveInputEntry>{};
+
+  void add(String path, String name, {required bool isDirectory}) {
+    if (name.isEmpty ||
+        name.contains('\\') ||
+        name.contains('\n') ||
+        name.contains('\r') ||
+        p.posix.isAbsolute(name) ||
+        p.windows.isAbsolute(name) ||
+        RegExp(r'^[A-Za-z]:').hasMatch(name) ||
+        name
+            .split('/')
+            .any((part) => part.isEmpty || part == '.' || part == '..')) {
+      throw FileSystemException('Unsafe archive entry name', name);
+    }
+    final previous = entries[name];
+    if (previous != null) {
+      if (previous.fullPath == path && previous.isDirectory == isDirectory) {
+        return;
+      }
+      throw FileSystemException('Conflicting archive entry name', name);
+    }
+    entries[name] = ArchiveInputEntry(path, name, isDirectory: isDirectory);
+  }
+
+  for (final source in sourcePaths) {
+    final type = FileSystemEntity.typeSync(source);
+    if (type != FileSystemEntityType.file &&
+        type != FileSystemEntityType.directory) {
+      continue;
+    }
+    final canonical = File(source).resolveSymbolicLinksSync();
+    final absolute = p.normalize(p.absolute(source));
+    final rootName = p.equals(p.dirname(absolute), absolute)
+        ? ''
+        : p.basename(absolute);
+    if (type == FileSystemEntityType.file) {
+      add(canonical, rootName, isDirectory: false);
+      continue;
+    }
+    if (rootName.isNotEmpty) add(canonical, rootName, isDirectory: true);
+    for (final child in Directory(
+      canonical,
+    ).listSync(recursive: true, followLinks: false)) {
+      // Never follow a nested symlink outside the selected directory.
+      if (child is! File && child is! Directory) continue;
+      final relative = p
+          .split(p.relative(child.path, from: canonical))
+          .join('/');
+      final name = rootName.isEmpty ? relative : '$rootName/$relative';
+      add(child.path, name, isDirectory: child is Directory);
+    }
+  }
+  return entries.values.toList();
+}
+
+/// Preserve Unicode paths with standard UTF-8 PAX records. The pinned archive
+/// package writes legacy TAR header names as code units, so non-ASCII names
+/// otherwise change during round-trip. Existing extraction supports PAX paths.
+List<int> encodeTarArchiveEntries(Archive archive) {
+  final output = OutputStream();
+  final encoder = TarEncoder()..start(output);
+  for (final entry in archive.files) {
+    final pathBytes = utf8.encode(entry.name);
+    if (entry.name.codeUnits.any((unit) => unit > 0x7f) ||
+        pathBytes.length > 100) {
+      final value = 'path=${entry.name}\n';
+      final valueLength = utf8.encode(value).length;
+      var length = valueLength + 2;
+      while (length != valueLength + length.toString().length + 1) {
+        length = valueLength + length.toString().length + 1;
+      }
+      final record = utf8.encode('$length $value');
+      final header = TarFile()
+        ..filename = 'PaxHeaders/fiyora-path'
+        ..fileSize = record.length
+        ..mode = 0
+        ..ownerId = 0
+        ..groupId = 0
+        ..lastModTime = 0
+        ..typeFlag = TarFile.TYPE_EX_HEADER
+        ..content = record;
+      header.write(output);
+      // A short ASCII header prevents the legacy encoder from emitting its
+      // own code-unit GNU long-name record over the UTF-8 PAX path.
+      final encodedEntry =
+          ArchiveFile('fiyora-entry', entry.size, entry.content)
+            ..isFile = entry.isFile
+            ..mode = entry.mode
+            ..ownerId = entry.ownerId
+            ..groupId = entry.groupId
+            ..lastModTime = entry.lastModTime
+            ..isSymbolicLink = entry.isSymbolicLink
+            ..nameOfLinkedFile = entry.nameOfLinkedFile;
+      encoder.add(encodedEntry);
+    } else {
+      encoder.add(entry);
+    }
+  }
+  encoder.finish();
+  return output.getBytes();
+}
