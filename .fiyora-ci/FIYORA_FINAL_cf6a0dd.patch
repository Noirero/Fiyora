--- /dev/null
+++ b/lib/services/archive_worker_lifecycle.dart
@@ -0,0 +1,83 @@
+/// Cancellation is a request until the worker's actual exit is observed.
+enum ArchiveWorkerPhase {
+  starting,
+  running,
+  cancelRequested,
+  workerExiting,
+  cancelConfirmed,
+  interrupted,
+  completed,
+  partial,
+  failed,
+}
+
+class ArchiveWorkerLifecycle {
+  ArchiveWorkerLifecycle(this.operationId);
+
+  final String operationId;
+  ArchiveWorkerPhase phase = ArchiveWorkerPhase.starting;
+  bool cancelRequested = false;
+  bool workerExitConfirmed = false;
+  bool spawnFailure = false;
+  bool workerStarted = false;
+  Map<String, dynamic>? terminalMessage;
+
+  bool get isTerminal => workerExitConfirmed || spawnFailure;
+
+  bool requestCancellation(String id) {
+    if (id != operationId ||
+        isTerminal ||
+        terminalMessage != null ||
+        cancelRequested) {
+      return false;
+    }
+    cancelRequested = true;
+    phase = ArchiveWorkerPhase.cancelRequested;
+    return true;
+  }
+
+  void workerAttached({bool willRun = true}) {
+    workerStarted = willRun;
+    if (!cancelRequested && !isTerminal) phase = ArchiveWorkerPhase.running;
+  }
+
+  void workerStopDispatched() {
+    if (cancelRequested && !isTerminal) {
+      phase = ArchiveWorkerPhase.workerExiting;
+    }
+  }
+
+  void receiveTerminal(Map<String, dynamic> message) {
+    if (isTerminal || terminalMessage != null) return;
+    terminalMessage = Map<String, dynamic>.from(message);
+  }
+
+  void confirmWorkerExit() {
+    if (isTerminal) return;
+    workerExitConfirmed = true;
+    // A worker result already sent before its exit wins over a late cancel.
+    // Exit after kill alone does NOT prove that no output was published.
+    phase = switch (terminalMessage?['status']) {
+      'completed' => ArchiveWorkerPhase.completed,
+      'partial' => ArchiveWorkerPhase.partial,
+      'cancelled' => ArchiveWorkerPhase.cancelConfirmed,
+      'error' => ArchiveWorkerPhase.failed,
+      _ =>
+        cancelRequested
+            ? (workerStarted
+                  ? ArchiveWorkerPhase.interrupted
+                  : ArchiveWorkerPhase.cancelConfirmed)
+            : ArchiveWorkerPhase.failed,
+    };
+  }
+
+  void spawnFailed(Object error) {
+    receiveTerminal({
+      'status': 'error',
+      'error': 'Worker could not start: $error',
+    });
+    // A failed spawn produced no worker. Do not invent an exit acknowledgement.
+    spawnFailure = true;
+    phase = ArchiveWorkerPhase.failed;
+  }
+}
