+                  ['completed', 'partial', 'error'].contains(event['status']),
+            )
+            .timeout(const Duration(seconds: 30));
+        // Execute the worker entrypoint in this zone because IOOverrides are
+        // isolate-local. Other tests above still spawn the real worker isolate.
+        await withInaccessibleCleanupMetadata(
+          destination,
+          () => BackgroundArchiveService.compressIsolateTask({
+            'sendPort': port.sendPort,
+            'sourcePaths': [source.path],
+            'destinationPath': destination,
+            'format': 'zip',
+            'level': 6,
+            'deleteSource': true,
+          }),
+        );
+        final result = await terminal as Map;
+        expect(result['status'], 'partial', reason: '$result');
+        expect(result['archiveCreated'], isTrue);
+        expect(
+          (result['sourceCleanupFailures'] as List).single['path'],
+          source.path,
+        );
+        expectArchiveRetained(destination);
+      } finally {
+        port.close();
+      }
+    },
+  );
+
+  test(
+    'direct creation reports cleanup failure without hiding archive success',
+    () async {
+      denySourceDeletion();
+      // Dynamic tear-off permits this test to exercise the old Future<void> API
+      // before the typed result exists: baseline returns null/full success.
+      final dynamic create = ArchiveService.createArchive;
+      final dynamic result = await create(
+        sourcePaths: [source.path],
+        destinationDir: output.path,
+        archiveName: 'created',
+        format: 'zip',
+        compressionLevel: 6,
+        deleteSource: true,
+        separateArchives: false,
+      );
+      expect(
+        result,
+        isNotNull,
+        reason: 'Cleanup failure requires an explicit outcome',
+      );
+      expect(result.archiveCreated, isTrue);
+      expect(result.isPartial, isTrue);
+      expect(result.sourceCleanupFailures.single.path, source.path);
+      expect(result.message, contains('could not be removed'));
+      expect(result.message, isNot(contains('created successfully')));
+      expectArchiveRetained(p.join(output.path, 'created.zip'));
+    },
+  );
+
+  test(
+    'worker reports partial instead of error/completed after cleanup failure',
+    () async {
+      denySourceDeletion();
+      final destination = p.join(output.path, 'worker.zip');
+      final result = await compressInWorker([source.path], destination);
+      expect(result['status'], 'partial', reason: '$result');
+      expect(result['archiveCreated'], isTrue);
+      expect(
+        (result['sourceCleanupFailures'] as List).single['path'],
+        source.path,
+      );
+      expect(result['archivePaths'], [destination]);
+      expect(result['reason'], 'sourceCleanupFailed');
+      expectArchiveRetained(destination);
+    },
+  );
+
+  test(
+    'direct mixed cleanup reports every failed source and continues once',
+    () async {
+      denySourceDeletion();
+      final removable = File(p.join(fixture.path, 'removable.txt'))
+        ..writeAsStringSync('REMOVE');
+      final result = await ArchiveService.createArchive(
+        sourcePaths: [source.path, removable.path],
+        destinationDir: output.path,
+        archiveName: 'mixed',
+        format: 'zip',
+        compressionLevel: 6,
+        deleteSource: true,
+        separateArchives: false,
+      );
+      expect(result.isPartial, isTrue);
+      expect(result.sourceCleanupFailures.map((f) => f.path), [source.path]);
+      expect(removable.existsSync(), isFalse);
+      expectArchiveRetained(p.join(output.path, 'mixed.zip'));
+    },
+  );
+
+  test(
+    'worker mixed cleanup does not lose archive success or untouched source',
+    () async {
+      denySourceDeletion();
+      final removable = File(p.join(fixture.path, 'removable.txt'))
+        ..writeAsStringSync('REMOVE');
+      final destination = p.join(output.path, 'mixed-worker.zip');
+      final result = await compressInWorker([
+        source.path,
+        removable.path,
+      ], destination);
+      expect(result['status'], 'partial');
+      expect((result['sourceCleanupFailures'] as List).length, 1);
+      expect(removable.existsSync(), isFalse);
+      expectArchiveRetained(destination);
+    },
+  );
+
+  test(
+    'separate archives retain all created outputs after a cleanup failure',
+    () async {
+      denySourceDeletion();
+      final removable = File(p.join(fixture.path, 'removable.txt'))
+        ..writeAsStringSync('REMOVE');
+      final result = await ArchiveService.createArchive(
+        sourcePaths: [source.path, removable.path],
+        destinationDir: output.path,
+        archiveName: 'unused',
+        format: 'zip',
+        compressionLevel: 6,
+        deleteSource: true,
+        separateArchives: true,
+      );
+      expect(result.archivePaths, [
+        p.join(output.path, 'source.zip'),
+        p.join(output.path, 'removable.zip'),
+      ]);
+      expect(
+        result.archivePaths.every((path) => File(path).existsSync()),
+        isTrue,
+      );
+      expect(result.isPartial, isTrue);
+      expect(result.sourceCleanupFailures.single.path, source.path);
+      expect(removable.existsSync(), isFalse);
+      expectArchiveRetained(p.join(output.path, 'source.zip'));
+    },
+  );
+
+  test(
+    'deleteSource false never attempts cleanup and retains ordinary success',
+    () async {
+      denySourceDeletion();
+      final result = await ArchiveService.createArchive(
+        sourcePaths: [source.path],
+        destinationDir: output.path,
+        archiveName: 'keep',
+        format: 'zip',
+        compressionLevel: 6,
+        deleteSource: false,
+        separateArchives: false,
+      );
+      expect(result.archiveCreated, isTrue);
+      expect(result.isPartial, isFalse);
+      expect(result.sourceCleanupFailures, isEmpty);
+      expect(result.toWorkerMessage()['status'], 'completed');
+      expectArchiveRetained(p.join(output.path, 'keep.zip'));
+    },
+  );
+
+  test(
+    'direct retry is explicit and never overwrites the retained archive',
+    () async {
+      denySourceDeletion();
+      Future<ArchiveCreationOutcome> create(String name) =>
+          ArchiveService.createArchive(
+            sourcePaths: [source.path],
+            destinationDir: output.path,
+            archiveName: name,
+            format: 'zip',
+            compressionLevel: 6,
+            deleteSource: true,
+            separateArchives: false,
+          );
+      expect((await create('first')).isPartial, isTrue);
+      final preserved = File(
+        p.join(output.path, 'first.zip'),
+      ).readAsBytesSync();
+      Process.runSync('chmod', ['0755', locked.path]);
+      await expectLater(create('first'), throwsA(isA<FileSystemException>()));
+      expect(source.readAsStringSync(), 'SOURCE');
+      final next = await create('retry');
+      expect(next.isPartial, isFalse);
+      expect(source.existsSync(), isFalse);
+      expect(
+        File(p.join(output.path, 'first.zip')).readAsBytesSync(),
+        preserved,
+      );
+    },
+  );
+
+  test(
+    'worker retry preserves earlier archive and only cleans on explicit new output',
+    () async {
+      denySourceDeletion();
+      final first = p.join(output.path, 'first.zip');
+      expect(
+        (await compressInWorker([source.path], first))['status'],
+        'partial',
+      );
+      final preserved = File(first).readAsBytesSync();
+      Process.runSync('chmod', ['0755', locked.path]);
+      expect((await compressInWorker([source.path], first))['status'], 'error');
+      expect(source.readAsStringSync(), 'SOURCE');
+      final next = await compressInWorker([
+        source.path,
+      ], p.join(output.path, 'retry.zip'));
+      expect(next['status'], 'completed');
+      expect(next['sourceCleanupFailures'], isEmpty);
+      expect(source.existsSync(), isFalse);
+      expect(File(first).readAsBytesSync(), preserved);
+    },
+  );
+}
